<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OptionPreferenceActivity">

    <LinearLayout
        android:id="@+id/aOPTitle"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/aOPBody"
        android:background="?attr/headerLink">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/opcionPreferencias"
            android:textSize="50sp"
            android:layout_weight="0.8"
            android:textColor="?attr/headerText"
            android:gravity="center"/>
        <LinearLayout
            android:id="@+id/aOPClose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="0.2">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/close_24dp"
                android:layout_weight="0.7"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="Cerrar"
                android:textSize="20sp"
                android:textColor="?attr/headerText"
                android:layout_weight="0.3"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aOPBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/aOPTitle"
        app:layout_constraintBottom_toTopOf="@+id/aOPFooter"
        android:orientation="vertical"
        android:background="?attr/body">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="0.15">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo cocina"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/subHeaderText"
                android:background="?attr/subHeader"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="5dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Mantiene la pantalla siempre encendida mientras cocinas"
                    android:layout_weight="0.7"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:checked="true"
                    android:layout_weight="0.3"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="0.3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/subHeader">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tamaño de letra"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/aOPSliderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:textSize="40sp"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/aOPSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="0.25">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="?attr/subHeader"
                android:layout_weight="0.35">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tema claro u oscuro"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_weight="0.65"
                android:padding="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="Usa fondo blanco y texto oscuro para leer mejor con mucha luz"
                        android:layout_weight="0.7"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:checked="true"
                        android:layout_weight="0.3"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="Usa colores oscuros para cansar menos la vista"
                        android:layout_weight="0.7"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:checked="true"
                        android:layout_weight="0.3"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="0.3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/subHeader">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Unidades de medida"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peso"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Gramos (g)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Kilogramos (kg)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Gramos (g)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Onzas (oz)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Volumen"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Mililitros (ml)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Litros (l)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Centilitros (cl)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Taza (cup)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cucharas"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Cucharadita (tsp)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Cucharada (tbsp)"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <CheckBox
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0.2"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="Cucharada de postre"
                                android:gravity="center_vertical"
                                android:layout_weight="0.8"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aOPFooter"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toBottomOf="@+id/aOPBody"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:padding="10dp"
        android:background="?attr/footer">

        <Button
            android:id="@+id/aOPAccept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aceptar"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>