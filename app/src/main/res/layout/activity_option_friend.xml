<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OptionFriendActivity">

    <LinearLayout
        android:id="@+id/aOFTitle"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/aOFBody"
        android:background="?attr/headerLink">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/opcionAmigos"
            android:textSize="50sp"
            android:layout_weight="0.8"
            android:textColor="?attr/headerText"
            android:gravity="center"/>
        <LinearLayout
            android:id="@+id/aOFClose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="0.2">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/close_24dp"
                android:layout_weight="0.7"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="Cerrar"
                android:textSize="20sp"
                android:textColor="?attr/headerText"
                android:layout_weight="0.3"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aOFBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/aOFTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="10dp"
        android:background="?attr/body"
        android:orientation="vertical">

        <com.google.android.material.search.SearchBar
            android:id="@+id/aOFSearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            android:hint="Buscar amigo por nombre"
            android:backgroundTint="?attr/headerText"
            android:layout_weight="0.1">

        </com.google.android.material.search.SearchBar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:orientation="vertical"
                android:layout_marginBottom="12.5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"
                    android:text="Amigos"
                    android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.9"
                    tools:listitem="@layout/friend_item"
                    tools:itemCount="6"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:orientation="vertical"
                android:layout_marginTop="12.5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"
                    android:text="Solicitudes de amistad"
                    android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.9"
                    tools:listitem="@layout/friend_requests_item"
                    tools:itemCount="6"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>