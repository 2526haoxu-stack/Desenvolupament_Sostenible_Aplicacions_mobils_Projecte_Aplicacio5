<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingActivity">

    <LinearLayout
        android:id="@+id/aSTitle"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/body"
        android:gravity="center"
        android:background="?attr/headerLink">

        <ImageView
            android:id="@+id/aSBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/back_24dp"
            android:layout_weight="0.2"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/configuracion"
            android:textSize="50sp"
            android:layout_weight="0.9"
            android:textColor="?attr/headerText"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/aSTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:paddingTop="15dp"
        android:paddingStart="30dp"
        android:background="?attr/body">

        <LinearLayout
            android:id="@+id/aSOptionLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/language_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:id="@+id/aSOptionLanguagesText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/opcionIdiomas"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/lock_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/opcionSeguridad"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/privacy_tip_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionPrivacidad"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/notifications_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionNotificaciones"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionPreference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/preference_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionPreferencias"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionFriend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/friend_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionAmigos"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOChangeCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/change_count_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar de cuenta"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOLogOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/logout_24dp"
                android:paddingEnd="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar de sesión"
                android:textSize="35sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>