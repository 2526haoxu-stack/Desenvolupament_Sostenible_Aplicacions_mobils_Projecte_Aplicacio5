<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/aSBody"
        android:background="?attr/headerLink"
        android:theme="@style/ThemeOverlay.AppCompat.Light">

        <LinearLayout
            android:id="@+id/aSTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/aSBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/back_24dp"
                android:layout_weight="0.2"
                android:contentDescription="@string/volver_hacia_atras"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/configuracion"
                android:textSize="40sp"
                android:layout_weight="0.8"
                android:textColor="?attr/headerText"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:id="@+id/aSBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/my_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:paddingTop="15dp"
        android:paddingStart="25dp"
        android:paddingEnd="0dp"
        android:background="?attr/body">

        <LinearLayout
            android:id="@+id/aSOptionLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/language_24dp"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:contentDescription="@string/icono_de_idiomas"/>
            <TextView
                android:id="@+id/aSOptionLanguagesText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/opcionIdiomas"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/lock_24dp"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:contentDescription="@string/icono_de_candado"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/opcionSeguridad"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/privacy_24dp"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:contentDescription="@string/icono_de_privacidad"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionPrivacidad"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/notifications_24dp"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:contentDescription="@string/icono_de_notificacion"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionNotificaciones"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionPreference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/preference_24dp"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:contentDescription="@string/icono_de_preferencia"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionPreferencias"
                android:textSize="35sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aSOptionFriend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/friends_24dp"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:contentDescription="@string/icono_de_amigos"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opcionAmigos"
                android:textSize="35sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>