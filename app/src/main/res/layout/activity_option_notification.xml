<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OptionNotificationActivity">

    <LinearLayout
        android:id="@+id/aONTitle"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/aONBody"
        android:background="?attr/headerLink">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/opcionNotificaciones"
            android:textSize="50sp"
            android:layout_weight="0.8"
            android:textColor="?attr/headerText"
            android:gravity="center"/>
        <LinearLayout
            android:id="@+id/aONClose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_weight="0.2">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/close_24dp"
                android:layout_weight="0.7"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="Cerrar"
                android:textSize="20sp"
                android:textColor="?attr/headerText"
                android:layout_weight="0.3"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aONBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/aONTitle"
        app:layout_constraintBottom_toTopOf="@+id/aONFooter"
        android:orientation="vertical"
        android:background="?attr/body">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Temporizador"
                android:textSize="30sp"
                android:textStyle="bold"
                android:background="?attr/subHeader"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="15dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mensaje de la notificación">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/aONSliderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="40sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="min"/>
                </LinearLayout>
                <com.google.android.material.slider.Slider
                    android:id="@+id/aONSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.15"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/subHeader"
                android:text="recomendaciones para ti"
                android:textStyle="bold"
                android:textSize="30sp"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Según lo que cocinas, te sugerimos platos con ingredientes y sabores similares"
                    android:layout_weight="0.7"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:checked="true"
                    android:layout_weight="0.3"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.15"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="recetas de chefs que sigues"
                android:textSize="30sp"
                android:textStyle="bold"
                android:background="?attr/subHeader"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Recibe una notificación al instante cuando los chefs que sigues publiquen una receta nueva"
                    android:layout_weight="0.7"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:checked="true"
                    android:layout_weight="0.3"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.15"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/subHeader"
                android:text="receta del dia"
                android:textStyle="bold"
                android:textSize="30sp"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Verás recetas del dia pasado las 6 de la mañana"
                    android:layout_weight="0.7"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:checked="true"
                    android:layout_weight="0.3"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aONFooter"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="?attr/footer"
        app:layout_constraintTop_toBottomOf="@+id/aONBody"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:padding="10dp">

        <Button
            android:id="@+id/aONAccept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aceppt"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>